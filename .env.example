GEMINI_API_KEY=your-key-here

# The password gate. One shared password, no username. UNSET MEANS NO GATE, which is what
# keeps local dev and `make walkthrough` untouched — set it only where the app is public.
# The hosted instance gets its value from vault_decabot_password; see docs/DEPLOY.md.
DECABOT_PASSWORD=

# Public-load protection, for when a QR code points a room full of phones at the same
# tunnel the demo is running on. All optional; unset means off.
#
# CONCIERGE_VIP_TOKEN     any random string. The presenting laptop opens the app as
#                         ?vip=<token> and never queues. Unset = nobody queues, which
#                         is the safe default: a typo must not put the demo in a line.
# CONCIERGE_PUBLIC_SLOTS  concurrent turns the public shares (default 3).
# GEMINI_PUBLIC_KEYS      comma-separated keys the public round-robins. GEMINI_API_KEY
#                         is deliberately NOT in the pool — it stays reserved for the
#                         demo, because per-project quota is the one bottleneck no
#                         amount of in-app queueing can protect.
CONCIERGE_VIP_TOKEN=
CONCIERGE_PUBLIC_SLOTS=3
GEMINI_PUBLIC_KEYS=
