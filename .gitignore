.states
.web
# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Reflex build output and session state
.web/
.states/
# reflex.lock/ is NOT ignored: the Dockerfile COPYs it and .dockerignore
# un-ignores it, so a clean clone cannot build the image without it.
*.db

# Vendored binaries — fetched by `make setup`, never committed
bin/

# Runtime logs and traces
run.log
*.jsonl
.reflex-*.log

# Quick-tunnel logs and the ephemeral judge URLs
.tunnel/

# Playwright MCP run artifacts
.playwright-mcp/

# Scraped brand assets — re-fetchable, never committed
assets/external/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Agent scratch space. `.claude/worktrees/*` are git worktree gitlinks, and a
# `git add -A` commits them as bare submodule entries that nobody can check out.
.claude/

# LibreOffice/OpenOffice lock files for an open document
.~lock.*#
